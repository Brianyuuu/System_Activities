{
  "latest_phrase_pipeline": {
    "api_key_env": "LITELLM_API_KEY",
    "api_workers": 8,
    "atomize_batch_size": 4,
    "atomize_max_retries": 2,
    "atomize_max_tokens": 4000,
    "atomize_request_timeout": 90,
    "audit_max_retries": 3,
    "audit_max_tokens": 4000,
    "audit_model": "parcc/GLM",
    "audit_request_timeout": 90,
    "base_url": "https://litellm.parcc.upenn.edu",
    "base_url_env": "LITELLM_BASE_URL",
    "chunk_chars": 3000,
    "clause_threshold": 350,
    "clean_manifest": "inputs/releases/v1/approved_manifest.csv",
    "cpu_workers": 2,
    "decompose_batch_size": 1,
    "decompose_max_retries": 1,
    "dedup_max_retries": 2,
    "dedup_max_tokens": 2000,
    "dedup_request_timeout": 90,
    "enabled": true,
    "entity_max_retries": 2,
    "entity_max_tokens": 4000,
    "entity_request_timeout": 90,
    "env_file": "environment-only.env",
    "item1_min_words": 500,
    "item1_warning_words": 1500,
    "max_retries": 2,
    "max_tokens": 24000,
    "model": "parcc/GLM",
    "output_root": "outputs/phrases",
    "prompt_root": "runtime/prompts",
    "slurm_array_parallelism": 1,
    "slurm_chunk_size": 1,
    "source_root": "runtime/pipeline_source"
  },
  "source_scope": "primary_item1_only"
}
